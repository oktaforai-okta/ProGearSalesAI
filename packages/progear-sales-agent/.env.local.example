# ===========================================
# ProGear Sales Agent - Local Environment
# ===========================================
# Copy this file to .env.local and update values as needed
# .env.local is automatically loaded by Next.js and is gitignored

# -------------------------------------------
# API Configuration
# -------------------------------------------
# Backend API URL - change this when deploying or using a different backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# -------------------------------------------
# Okta Configuration (Public - exposed to browser)
# -------------------------------------------
NEXT_PUBLIC_OKTA_CLIENT_ID=wlpuoor63yK6LYFEh1d7
NEXT_PUBLIC_OKTA_DOMAIN=https://oktaforai.oktapreview.com
NEXT_PUBLIC_OKTA_ISSUER=https://oktaforai.oktapreview.com

# -------------------------------------------
# NextAuth Configuration
# -------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-here

# Server-only private JWK for private_key_jwt client authentication.
# Register only the matching public JWK on the direct User access app.
OKTA_OIDC_PRIVATE_KEY={"kty":"RSA","kid":"xxx","alg":"RS256","n":"...","e":"...","d":"...","p":"...","q":"...","dp":"...","dq":"...","qi":"..."}

# -------------------------------------------
# MCP Server Configuration
# -------------------------------------------
MCP_SERVER_URL=http://localhost:3001
