# ===========================================
# ProGear Sales AI - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# -------------------------------------------
# LLM Configuration
# -------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-xxx
OPENAI_API_KEY=sk-xxx
LLM_BASE_URL=https://api.openai.com/v1
X_GATEWAY_SECRET=your-gateway-secret-here

# -------------------------------------------
# Okta Configuration (AI Agent Governance)
# -------------------------------------------
# Your Okta domain
OKTA_DOMAIN=https://your-org.okta.com

# Interactive employee sign-in uses an OIDC web client. In the compatibility
# deployment this is a separate 0oa... app linked to the governed agent.
OKTA_CLIENT_ID=0oa_your_user_access_client_id
OKTA_AI_AGENT_ID=wlp_your_agent_id

# Server-only private key for the User access OIDC client. Register only the
# corresponding public JWK on the agent-linked OIDC app.
OKTA_OIDC_PRIVATE_KEY={"kty":"RSA","kid":"xxx","alg":"RS256","n":"...","e":"...","d":"...","p":"...","q":"...","dp":"...","dq":"...","qi":"..."}

# Sales Agent workload key used by the backend ID-JAG exchanges.
OKTA_AI_AGENT_PRIVATE_KEY={"kty":"RSA","kid":"xxx","alg":"RS256","n":"...","e":"...","d":"...","p":"...","q":"...","dp":"...","dq":"...","qi":"..."}

# Dedicated least-privilege OAuth service client used only after VP approval.
# Configure private_key_jwt, client_credentials, and inventory:write on the
# Inventory Authorization Server. Do not reuse the AI Agent workload key.
OKTA_APPROVAL_EXECUTOR_CLIENT_ID=0oa_your_approval_executor_client_id
OKTA_APPROVAL_EXECUTOR_PRIVATE_KEY={"kty":"RSA","kid":"xxx","alg":"RS256","use":"sig","n":"...","e":"...","d":"...","p":"...","q":"...","dp":"...","dq":"...","qi":"..."}

# -------------------------------------------
# Authorization Servers
# -------------------------------------------
# Org Authorization Server alias used for the ID token -> ID-JAG exchange.
OKTA_MAIN_AUTH_SERVER_ID=default

# Per-domain authorization servers used for scoped resource tokens.
OKTA_SALES_AUTH_SERVER_ID=aus_your_sales_server_id
OKTA_SALES_AUDIENCE=api://progear-sales
OKTA_INVENTORY_AUTH_SERVER_ID=aus_your_inventory_server_id
OKTA_INVENTORY_AUDIENCE=api://progear-inventory
OKTA_CUSTOMER_AUTH_SERVER_ID=aus_your_customer_server_id
OKTA_CUSTOMER_AUDIENCE=api://progear-customer
OKTA_PRICING_AUTH_SERVER_ID=aus_your_pricing_server_id
OKTA_PRICING_AUDIENCE=api://progear-pricing

# -------------------------------------------
# FGA Configuration
# -------------------------------------------
# Hosted FGA (Fine-Grained Authorization)
FGA_STORE_ID=xxxxxxxxxxxxxxx
FGA_MODEL_ID=xxxxxxxxxxxxxxx
FGA_CLIENT_ID=xxxxxxxxxxxxxxx
FGA_CLIENT_SECRET=xxxxxxxxxxxxxxx
FGA_API_URL=https://api.us1.fga.dev
FGA_API_TOKEN_ISSUER=auth.fga.dev
FGA_API_AUDIENCE=https://api.us1.fga.dev/

# -------------------------------------------
# Okta profile controls + Identity Governance approval
# -------------------------------------------
# Admin API token used only by the scoped self-service demo controls, the live
# pre-exchange clearance lookup, and OIG approver verification.
OKTA_API_TOKEN=your-okta-api-token

OKTA_OIG_BASE_URL=https://your-org.okta.com
OKTA_OIG_API_TOKEN=your-okta-oig-api-token
OKTA_OIG_INVENTORY_REQUEST_TYPE_ID=your-request-type-id
OKTA_OIG_JUSTIFICATION_FIELD_ID=your-justification-field-id
APPROVAL_QUANTITY_THRESHOLD=601
APPROVAL_POLL_INTERVAL_SECONDS=120
APPROVAL_STATUS_CACHE_TTL_SECONDS=8
OKTA_VP_APPROVER_GROUP_NAME=ProGear-VPs

# -------------------------------------------
# Frontend Configuration (Next.js on Vercel)
# -------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-here

# Public vars (exposed to browser)
NEXT_PUBLIC_OKTA_CLIENT_ID=0oa_your_user_access_client_id
NEXT_PUBLIC_OKTA_DOMAIN=https://your-org.okta.com
NEXT_PUBLIC_OKTA_ISSUER=https://your-org.okta.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# -------------------------------------------
# Backend Configuration (FastAPI on Render)
# -------------------------------------------
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# -------------------------------------------
# MCP Server Configuration (on Render)
# -------------------------------------------
MCP_SERVER_URL=http://localhost:3001
MCP_SERVER_PORT=3001

# -------------------------------------------
# Deployment URLs (update after deploying)
# -------------------------------------------
# NEXT_PUBLIC_API_URL=https://progear-backend.onrender.com
# MCP_SERVER_URL=https://progear-mcp.onrender.com
# NEXTAUTH_URL=https://progear-sales.vercel.app
# CORS_ORIGINS=https://progear-sales.vercel.app
